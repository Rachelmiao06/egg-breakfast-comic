# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env file in the repo
!.env.example

# parallel-session worktrees
/.claude/worktrees/

# background-scenes 会话的录屏、截图、无头检查输出（大文件不入库）
/notes/background-scenes/*.mp4
/notes/background-scenes/*.webm
/notes/background-scenes/frames/
/notes/background-scenes/shots/
/notes/background-scenes/.profile/
/notes/background-scenes/samples-*.json

# 厨房分层的整画布中间文件（tools/split_scene.py 输出，页面加载的是打包后的 webp）
source/layers/
